# 本机 R2 上传凭据（复制为 .env 后填写；.env 已 gitignore，勿提交）
# 获取步骤（Cloudflare Dashboard + 本机 wrangler）：见 ops/worker-r2-ops.md §3.1
# 官方：https://developers.cloudflare.com/r2/api/tokens/

# Account ID：Dashboard → Workers & Pages / 域 Overview → Account ID
# 或本机：npx wrangler whoami
R2_ACCOUNT_ID=

# Access Key ID + Secret：Dashboard → R2 → Overview → Account Details
# → API Tokens → Manage → Create … token（Object Read & Write，可限定桶 onlinefreetools-pages）
# Secret 只在创建成功页显示一次
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 可选
# R2_PAGES_BUCKET=onlinefreetools-pages
# R2_UPLOAD_CONCURRENCY=32
# R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
