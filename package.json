{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "start:dev": "node ops/dev/start-dev.mjs",
    "stop:dev": "node ops/dev/stop-dev.mjs",
    "status:dev": "node ops/dev/status-dev.mjs",
    "restart:dev": "node ops/dev/stop-dev.mjs && node ops/dev/start-dev.mjs",
    "cf-typegen": "wrangler types",
    "build:logs": "node scripts/build-logs.mjs",
    "build:site": "node scripts/build-site.mjs",
    "lint:seo": "node scripts/validate-tool-seo.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "indexnow:sitemap": "node scripts/submit-indexnow.mjs --sitemap",
    "indexnow:remote-sitemap": "node scripts/submit-indexnow.mjs --remote-sitemap",
    "indexnow:check": "node scripts/submit-indexnow.mjs --check-key",
    "indexnow:help": "node scripts/submit-indexnow.mjs --help",
    "predeploy": "npm run build:site && npm run lint:seo"
  },
  "dependencies": {
    "chanfana": "^2.6.3",
    "hono": "^4.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/service-worker-mock": "^2.0.4",
    "wrangler": "^4.58.0",
    "marked": "^11.1.1"
  }
}