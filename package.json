{
  "name": "cloudflare-workers-openapi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "start:dev": "node ops/dev/start-dev.mjs",
    "stop:dev": "node ops/dev/stop-dev.mjs",
    "status:dev": "node ops/dev/status-dev.mjs",
    "restart:dev": "node ops/dev/stop-dev.mjs && node ops/dev/start-dev.mjs",
    "cf-typegen": "wrangler types",
    "build:logs": "node scripts/build-logs.mjs",
    "split:tools": "node scripts/tool-modules/split-once.mjs",
    "merge:tools": "node scripts/tool-modules/merge-all.mjs",
    "tool:touch": "node scripts/bump-tool-updated-at.mjs",
    "build:site": "npm run merge:tools && node scripts/build-site.mjs --full",
    "build:site:changed": "npm run merge:tools && node scripts/build-site.mjs --full",
    "build:site:full": "npm run merge:tools && node scripts/build-site.mjs --full",
    "prerender:tools": "node scripts/prerender-tool-pages.mjs --full",
    "prerender:tools:changed": "node scripts/prerender-tool-pages.mjs --full",
    "prerender:tools:full": "node scripts/prerender-tool-pages.mjs --full",
    "gzip:pages": "node scripts/gzip-pages.mjs",
    "gzip:pages:changed": "node scripts/gzip-pages.mjs --changed-tools",
    "gzip:pages:full": "node scripts/gzip-pages.mjs --force",
    "upload:r2": "node scripts/upload-r2-pages.mjs --changed-only",
    "upload:r2:changed": "node scripts/upload-r2-pages.mjs --changed-only",
    "upload:r2:full": "node scripts/upload-r2-pages.mjs",
    "upload:r2:local": "node scripts/upload-r2-pages.mjs --local --changed-only",
    "verify:r2": "node scripts/verify-r2-worker-sync.mjs",
    "verify:r2:live": "node scripts/verify-r2-worker-sync.mjs --live",
    "deploy": "node scripts/deploy-site.mjs",
    "predeploy:changed": "npm run predeploy",
    "predeploy:full": "npm run build:site:full && npm run lint:seo && npm run lint:vendor",
    "deploy:changed": "node scripts/deploy-site.mjs",
    "deploy:full": "node scripts/deploy-site.mjs --full",
    "deploy:worker-only": "wrangler deploy",
    "deploy:skip-upload": "node scripts/deploy-site.mjs --skip-upload",
    "vendor:image-optimizer": "node scripts/copy-image-optimizer-vendor.mjs",
    "vendor:site-chrome": "node scripts/copy-site-chrome-vendor.mjs",
    "lint:seo": "node scripts/validate-tool-seo.mjs",
    "lint:taxonomy": "node scripts/validate-taxonomy.mjs",
    "coverage:gate": "node scripts/validate-tool-coverage-rounds.mjs",
    "lint:vendor": "node scripts/validate-vendor-tracked.mjs",
    "lint:tool-isolation": "node scripts/check-tool-isolation.mjs",
    "lint:tool-page": "node scripts/validate-tool-page-wiring.mjs",
    "verify": "npm run build:site && npm run lint:seo && npm run lint:vendor && npm run lint:taxonomy",
    "verify:full": "npm run build:site:full && npm run lint:seo && npm run lint:vendor && npm run lint:taxonomy",
    "stage:tools:changed": "node scripts/commit-changed-tools.mjs --changed-tools --stage-only",
    "commit:tools:changed": "node scripts/commit-changed-tools.mjs --changed-tools",
    "verify:tool": "node scripts/verify-tool.mjs",
    "taxonomy:apply": "node scripts/dev/apply-taxonomy-tags.mjs",
    "indexnow": "node ops/seo/submit-indexnow.mjs",
    "indexnow:sitemap": "node ops/seo/submit-indexnow.mjs --sitemap",
    "indexnow:remote-sitemap": "node ops/seo/submit-indexnow.mjs --remote-sitemap",
    "indexnow:incremental": "node ops/seo/submit-indexnow.mjs --incremental --remote-sitemap",
    "indexnow:since-git": "node ops/seo/submit-indexnow.mjs --since-git",
    "indexnow:baseline": "node ops/seo/submit-indexnow.mjs --baseline --remote-sitemap",
    "indexnow:check": "node ops/seo/submit-indexnow.mjs --check-key",
    "indexnow:help": "node ops/seo/submit-indexnow.mjs --help",
    "sitemap": "node ops/seo/generate-sitemap.mjs",
    "sitemap:ui": "node ops/seo/sitemap-ui.mjs",
    "ops:ui": "node ops/seo/sitemap-ui.mjs",
    "predeploy": "npm run build:site && npm run lint:seo && npm run lint:vendor"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "bootstrap": "^5.3.3",
    "chanfana": "^2.6.3",
    "gifenc": "^1.0.3",
    "hono": "^4.6.20",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@smithy/node-http-handler": "^4.11.3",
    "@types/node": "22.13.0",
    "@types/service-worker-mock": "^2.0.4",
    "esbuild": "^0.25.12",
    "https-proxy-agent": "^9.1.0",
    "marked": "^11.1.1",
    "socks-proxy-agent": "^10.1.0",
    "wrangler": "^4.58.0"
  }
}
