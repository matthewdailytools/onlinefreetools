/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "onlinefreetools",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
		/**
		 * 谷歌 HTML 验证要求 `/google….html` 精确 200、不能 307。
		 * 首页落在 Assets 常规路径（`/`、`/{lang}/`）时须 Worker 先跑，
		 * 否则 Assets 会直接出默认语首页，跳过 Accept-Language 协商。
		 * 工具等其它 HTML 仍 Assets miss → Worker → R2。
		 */
		"run_worker_first": [
			"/",
			"/en",
			"/en/",
			"/zh",
			"/zh/",
			"/es",
			"/es/",
			"/ar",
			"/ar/",
			"/pt",
			"/pt/",
			"/id",
			"/id/",
			"/fr",
			"/fr/",
			"/ja",
			"/ja/",
			"/ru",
			"/ru/",
			"/de",
			"/de/",
			"/google2cb457f0956f79d9.html",
			"/2f01147b65c24c4194c4f785eacafef9.txt"
		],
		"html_handling": "none"
	},
	"vars": {
		"SITE_DEFAULT_LANG": "en",
		"SITE_LANGS": "en,zh,es,ar,pt,id,fr,ja,ru,de",
		/** 发版递增可使 HTML Cache API key 失效（见 src/site/r2Pages.ts）。 */
		"PAGES_CACHE_VERSION": "4.4",
		/** Prompt AI：false/0/off 关闭 API 与前端按钮 */
		"PROMPT_AI_ENABLED": "true",
		/** Workers AI 默认小模型（上线前核对 Free ACL） */
		"PROMPT_AI_MODEL": "@cf/meta/llama-3.2-1b-instruct",
		"PROMPT_AI_MAX_INPUT_CHARS": "6000",
		"PROMPT_AI_MAX_OUTPUT_TOKENS": "384",
		"PROMPT_AI_DAILY_LIMIT_PER_IP": "8",
		"PROMPT_AI_MINUTE_LIMIT_PER_IP": "4",
		"PROMPT_AI_SITE_DAILY_LIMIT": "200"
	},
	/**
	 * 预渲染多语言 HTML（gzip）存储桶。
	 * 创建：`npx wrangler r2 bucket create onlinefreetools-pages`
	 * 预览桶可选：`npx wrangler r2 bucket create onlinefreetools-pages-preview`
	 */
	"r2_buckets": [
		{
			"binding": "PAGES_BUCKET",
			"bucket_name": "onlinefreetools-pages",
			"preview_bucket_name": "onlinefreetools-pages-preview"
		}
	],
	/**
	 * Workers AI：Prompt template builder Expand/Polish（见 ops/cloudflare-workers-ai-access.md）。
	 */
	"ai": {
		"binding": "AI"
	},
	/**
	 * 日级限流 KV。创建：wrangler kv namespace create RATE_LIMIT_KV
	 * 将返回的 id 填入下方（preview 用于 wrangler dev）。
	 */
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_KV",
			"id": "00000000000000000000000000000000",
			"preview_id": "00000000000000000000000000000000"
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
